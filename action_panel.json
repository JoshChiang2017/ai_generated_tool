      "name": "GIT",
      "description": "Quick access to git log across multiple repositories",
      "groups": [
        {
          "name": "Grace",
          "labels": [
            {
              "name": "Code",
              "path": "D:\\work\\Grace\\code\\git2",
              "enabled": true,
              "actions": [
                {
                  "name": "BUILD",
                  "executable": "cmd",
                  "argsTemplate": "/C start /D {path}\\Board\\ServerMultiBoardPkg ProjectBuild.bat"
                }
              ]
            },
            {
              "name": "Board",
              "path": "D:\\work\\Grace\\code\\git2\\",
              "enabled": true,
              "actions": [
                {
                  "name": "bash",
                  "executableAlias": "git_bash",
                  "argsTemplate": "--cd={path}"
                },
                {
                  "name": "log",
                  "executable": "TortoiseGitProc",
                  "argsTemplate": "/command:log /path:{path}"
                }
              ]
            }
          ]
        },
